CONFIG_ENCRYPTION = false

NODE_ENV = 'production'
BUILD_TARGET = 'sea'
LOCAL_MODE = false
DEPLOY_ALLOW_DIRTY_GIT = false
TEST_MCP_ENABLED = false

DEBUG_NAME = "@lsby:punch-in"

DB_TYPE = "sqlite"
DB_PATH = "./db/prod-sea.db"
DB_PATH_PRISMA = "file:./${DB_PATH}"
DB_BACKUP_PATH = "./db"
DB_BACKUP_RETENTION_DAYS = 7
DB_BACKUP_PREFIX = "backup_"
DB_BACKUP_AUTO_PREFIX = "auto_"

DEFAULT_SYSTEM_USER = 'admin'
DEFAULT_SYSTEM_PWD = "123456"

APP_PORT = 37190
WEB_PORT = 37191
WEB_HMR_PORT = 37192
TEST_MCP_PORT = ''
BACKEND_URL = ""

UPLOAD_MAX_FILE_SIZE = 50

DEFAULT_JWT_SECRET = ""
JWT_EXPIRES_IN = '7d'

BCRYPT_ROUNDS = 10
